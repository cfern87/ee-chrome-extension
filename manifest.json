{
  "manifest_version": 3,
  "name": "Energy Economics' Life Management System Inbox",
  "version": "1.0",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "resources": ["lib/jquery-3.7.1.min.js"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  }
}
